{
  "name": "lexi-vocabulary-tutor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "backend:check": "deno check --config supabase/functions/deno.json supabase/functions/vocabulary/index.ts supabase/functions/review/index.ts supabase/functions/reverse-search/index.ts supabase/functions/ai/index.ts supabase/functions/notifications/index.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "deno": "^2.5.0",
    "prettier": "^3.9.9",
    "supabase": "^2.48.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^5.0.3"
  }
}
